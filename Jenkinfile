pipeline {
    agent any

    stages {
        stage('Ranjith -- Owner -- Checkout') {
            steps {
                echo 'From-Git-repo'
                git branch: 'main', url: 'https://github.com/devopstrainer657/devops_java.git'
            }
        }
        
        stage('Version Check') {
            steps {
                echo 'Compiling'
                sh 'mvn --version'
                
            }
        }        
        
        stage('Compile') {
            steps {
                echo 'Compiling'
                sh 'mvn clean compile'
                
            }
        }         
       
        stage('package') {
            steps {
                echo 'packaging'
                sh 'mvn package'
                
            }
        } 
       
        
    }
}
